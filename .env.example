# Public site URL — used for metadata, OG tags, and the sitemap.
NEXT_PUBLIC_SITE_URL="https://usemillwright.com"

# Postgres connection string for waitlist storage.
# Works with Neon, Supabase, Vercel Postgres, RDS, or self-hosted.
# If unset, signups fall back to a local JSON file at .data/waitlist.json
# (fine for `npm run dev`, NOT safe for a serverless deploy).
DATABASE_URL=""

# Optional: welcome email on signup. Both must be set or email is skipped.
RESEND_API_KEY=""
RESEND_FROM="Millwright <hello@usemillwright.com>"
